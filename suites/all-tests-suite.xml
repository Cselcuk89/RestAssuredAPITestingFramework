<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="All API Tests Suite" parallel="classes" thread-count="3">
    <test name="Health Check Tests">
        <classes>
            <class name="com.testautomation.apitesting.tests.HealthCheckTest"/>
        </classes>
    </test>
    <test name="Booking API Tests">
        <classes>
            <class name="com.testautomation.apitesting.tests.GetAPIRequest"/>
            <class name="com.testautomation.apitesting.tests.PostAPIRequest"/>
            <class name="com.testautomation.apitesting.tests.EndToEndAPITest"/>
        </classes>
    </test>
    <test name="Postman Echo Tests">
        <classes>
            <class name="com.testautomation.apitesting.tests.PostmanEchoTest"/>
        </classes>
    </test>
</suite>
